+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package com.shatteredpixel.shatteredpixeldungeon.actors.hero;
+
+/** All werewolf tuning lives here. There is no gameplay cap or diminishing kill reward. */
+public final class WerewolfBalance {
+    private WerewolfBalance() {}
+
+    public static final int HEALTH_KILLS = 5;
+    public static final int MEAT_KILLS = 20;
+    public static final int CLAW_KILLS = 50;
+    public static final int WHETSTONE_KILLS = 100;
+    public static final int CLAW_MIN = 2, CLAW_MAX = 8;
+    public static final int CLAW_MIN_PER_LEVEL = 1, CLAW_MAX_PER_LEVEL = 3;
+    public static final int CLAW_STRENGTH = 10;
+    public static final float ARMOR_FACTOR = 2f / 3f;
+    public static final float SPAWN_FACTOR = 1.25f;
+    public static final float RATION_DOUBLE_MEAT_CHANCE = 0.5f;
+    public static final float EAT_MEAT_TIME = 1f;
+    // One hunger band: STARVING (450) -> HUNGRY (300).
+    public static final float PASTY_ENERGY = 150f;
+    public static final int SCRAP_PER_TIER = 1, SCRAP_LEVEL_DIVISOR = 2;
+    public static final int REFINED_IRON_SCRAP_COST = 3, REFINED_IRON_ENERGY_COST = 0;
+    public static final int WHETSTONE_IRON_COST = 3, WHETSTONE_ENERGY_COST = 6;
+    public static final int SCRAP_VALUE = 5, WHETSTONE_VALUE = 40;
+
+    public static final float HEART_MAX_CHARGE = 3f, HEART_COST = 1f;
+    public static final int HEART_CAPACITY_LEVEL_INTERVAL = 2;
+    public static final float HEART_CHARGE_BASE = 10f, HEART_CHARGE_SCALE = 40f;
+    public static final float HEART_CHARGE_FACTOR = 0.875f;
+    public static final int HEART_BONUS_MIN = 1, HEART_BONUS_MAX = 3;
+    public static final float HEART_BLEED = 4f;
+    public static final float HARVEST_COOLDOWN = 20f;
+    public static final int FEAST_HEAL_KILLS = 5;
+    public static final float MEAT_SPEED = 1.5f;
+    public static final float BLOOD_FEAST_SPEED = 1.2f;
+
+    public static final int POUNCE_RANGE = 3;
+    public static final float POUNCE_MAX_CHARGE = 2f, POUNCE_COST = 1f;
+    public static final float POUNCE_RECHARGE_TURNS = 30f;
+    public static final float POUNCE_TIME = 1f;
+    public static final float AFTERIMAGE_EVASION = 1.5f;
+
+    public static final float RAMPAGE_COST = 35f, RAMPAGE_DURATION = 6f;
+    public static final float RAMPAGE_KILL_EXTENSION = 1f;
+    public static final float RAMPAGE_SPEED = 1.5f, RAMPAGE_ATTACK_SPEED = 1.3f;
+    public static final float RAMPAGE_ARMOR_FACTOR = 0.75f;
+    public static final float ENDLESS_DURATION_PER_POINT = 1f;
+    public static final float ENDLESS_EXTENSION_PER_POINT = 0.25f;
+    public static final int BLOOD_ARMOR_PER_POINT = 2, ROAR_DAMAGE_PER_POINT = 3;
+    public static final float ROAR_MARK_DURATION = 10f;
+    public static final long PROVISIONS_SEED_SALT = 0x57455245574F4C46L;
+
+    public static long milestones(long before, long after, int interval) {
+        if (before < 0 || after < before || interval <= 0) throw new IllegalArgumentException();
+        return after / interval - before / interval;
+    }
+    public static int meatStock(int points) { return points <= 0 ? 0 : Math.min(3, points + 1); }
+    public static int feastHealing(int points) { return points <= 0 ? 0 : points + 1; }
+    public static int hungryShield(int points) { return points <= 0 ? 0 : 1 + 2 * points; }
+    public static int starvingDamage(int points) { return points <= 0 ? 0 : 1 + 2 * points; }
+    public static float mealDuration(int points) { return points <= 0 ? 0 : 1 + 2 * points; }
+    public static float chainSpeed(int points) { return points <= 0 ? 1f : 1.1f + 0.1f * points; }
+    public static float harvestCharge(int points) { return 0.5f * points; }
+    public static float deepWounds(int points) { return 0.1f * points; }
+    public static float scentSpeed(int points) { return 1f + 0.25f * points; }
+    public static float thirstChance(int points) { return points <= 0 ? 0f : 0.1f + 0.1f * points; }
+    public static float bloodFeastDuration(int points) { return points <= 0 ? 0f : 1f + 2f * points; }
+    public static int pounceDamage(int points) { return 2 * points; }
+    public static float pounceRefund(int points) { return POUNCE_COST * 0.25f * points; }
+    public static float afterimageDuration(int points) { return points <= 0 ? 0f : 1f + points; }
+    public static float neckIgnore(int points) { return 0.25f * points; }
+    public static int armorRoll(int rolled, boolean rampaging) {
+        return Math.round(Math.max(0, rolled) * ARMOR_FACTOR * (rampaging ? RAMPAGE_ARMOR_FACTOR : 1f));
+    }
+    public static int scrapYield(int tier, int upgrades) {
+        return Math.max(1, tier) * SCRAP_PER_TIER + Math.max(0, upgrades) / SCRAP_LEVEL_DIVISOR;
+    }
+    public static int rationMeat(float roll) { return roll < RATION_DOUBLE_MEAT_CHANCE ? 2 : 1; }
+    public static float replenish(float current, float amount, float capacity) {
+        return Math.max(0f, Math.min(capacity, current + amount));
+    }
+    public static float heartCapacity(int clawLevel) {
+        return HEART_MAX_CHARGE + Math.max(0, clawLevel) / HEART_CAPACITY_LEVEL_INTERVAL;
+    }
+    public static float heartRecharge(float charge, float capacity) {
+        return 1f / (float)(HEART_CHARGE_BASE + HEART_CHARGE_SCALE
+                * Math.pow(HEART_CHARGE_FACTOR, Math.max(0f, capacity - charge)));
+    }
+}

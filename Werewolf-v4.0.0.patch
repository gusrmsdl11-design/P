+        Dungeon.level.mobs.add(marked);
+        Buff.prolong(marked, BeastRampage.PreyMark.class, 10);
+        rampage.act();
+        check(marked.buff(BeastRampage.PreyMark.class) == null, "rampage mark removed on expiry");
+        equal(WerewolfMechanics.movementSpeed(hero), 1, "rampage speed removed");
+        equal(WerewolfMechanics.attackSpeed(hero, null), 1, "rampage attack speed removed");
+        hero.belongings.armor = new FixedArmor();
+        equal(hero.drRoll(), 10, "rampage armor penalty removed");

+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package com.shatteredpixel.shatteredpixeldungeon.actors.hero;
+
+import com.shatteredpixel.shatteredpixeldungeon.Dungeon;
+import com.shatteredpixel.shatteredpixeldungeon.actors.Char;
+import com.shatteredpixel.shatteredpixeldungeon.actors.buffs.*;
+import com.shatteredpixel.shatteredpixeldungeon.actors.hero.abilities.werewolf.BeastRampage;
+import com.shatteredpixel.shatteredpixeldungeon.actors.mobs.Mob;
+import com.shatteredpixel.shatteredpixeldungeon.effects.FloatingText;
+import com.shatteredpixel.shatteredpixeldungeon.items.Item;
+import com.shatteredpixel.shatteredpixeldungeon.items.ClawWhetstone;
+import com.shatteredpixel.shatteredpixeldungeon.items.food.*;
+import com.shatteredpixel.shatteredpixeldungeon.items.weapon.melee.Claws;
+import com.shatteredpixel.shatteredpixeldungeon.sprites.CharSprite;
+import com.shatteredpixel.shatteredpixeldungeon.ui.BuffIndicator;
+import com.watabou.utils.Random;
+
+/** Hooks into the existing combat, food and kill lifecycles, rather than a second combat engine. */
+public final class WerewolfMechanics {
+    private WerewolfMechanics() {}
+    public static boolean isWerewolf(Hero hero) { return hero != null && hero.heroClass == HeroClass.WEREWOLF; }
+    public static Claws claws(Hero hero) {
+        return hero.belongings.weapon instanceof Claws ? (Claws)hero.belongings.weapon : null;
+    }
+    public static void give(Hero hero, Item item) {
+        if (!item.collect(hero.belongings.backpack)) Dungeon.level.drop(item, hero.pos).sprite.drop();
+    }
+    public static void heal(Hero hero, int amount) {
+        if (amount <= 0 || !hero.isAlive()) return;
+        int actual = Math.min(amount, hero.HT - hero.HP);
+        hero.HP += actual;
+        if (actual > 0 && hero.sprite != null)
+            hero.sprite.showStatusWithIcon(CharSprite.POSITIVE, Integer.toString(actual), FloatingText.HEALING);
+    }
+
+    /** Quotient differences also handle imported/batched kills crossing several reward boundaries. */
+    public static void addKills(Hero hero, long amount) {
+        if (!isWerewolf(hero) || amount <= 0) return;
+        long before = hero.werewolfKills;
+        long after = Math.addExact(before, amount);
+        hero.werewolfKills = after;
+        hero.updateHT(false); // permanent maximum only; do not implicitly heal on growth
+        Claws claws = claws(hero);
+        if (claws != null) claws.growTo(after);
+        long meat = WerewolfBalance.milestones(before, after, WerewolfBalance.MEAT_KILLS);
+        long stones = WerewolfBalance.milestones(before, after, WerewolfBalance.WHETSTONE_KILLS);
+        giveRewards(hero, meat, false);
+        giveRewards(hero, stones, true);
+        long pulses = WerewolfBalance.milestones(before, after, WerewolfBalance.FEAST_HEAL_KILLS);
+        int perPulse = WerewolfBalance.feastHealing(hero.pointsInTalent(Talent.PREDATORY_RECOVERY));
+        if (perPulse > 0 && pulses > 0)
+            heal(hero, (int)Math.min((long)hero.HT - hero.HP, pulses * perPulse));
+        Item.updateQuickslot();
+    }
+    private static void giveRewards(Hero hero, long count, boolean whetstone) {
+        while (count > 0) {
+            int batch = (int)Math.min(count, Integer.MAX_VALUE);
+            give(hero, (whetstone ? new ClawWhetstone() : new MysteryMeat()).quantity(batch));
+            count -= batch;
+        }
+    }
+    public static boolean isGrowthKill(Mob enemy) {
+        return enemy != null && enemy.alignment == Char.Alignment.ENEMY
+                && !enemy.summoned && !Char.hasProp(enemy, Char.Property.BOSS_MINION);
+    }
+    public static void onKill(Hero hero, Mob enemy) {
+        if (!isWerewolf(hero) || !hero.isAlive() || enemy.alignment != Char.Alignment.ENEMY) return;
+        // Combat kill buffs still work; summoned creatures cannot farm permanent rewards.
+        if (isGrowthKill(enemy)) addKills(hero, 1);
+        if (hero.hasTalent(Talent.SLAUGHTER_MOMENTUM)) {
+            Buff.detach(hero, SlaughterMomentum.class);
+            Buff.affect(hero, SlaughterMomentum.class);
+        }
+        if (hero.hasTalent(Talent.CHAIN_ASSAULT)) {
+            Buff.detach(hero, ChainAssault.class);
+            Buff.affect(hero, ChainAssault.class);
+        }
+        if (hero.subClass == HeroSubClass.BLOODFANG && enemy.buff(Bleeding.class) != null
+                && hero.hasTalent(Talent.BLOOD_FEAST)) {
+            Buff.prolong(hero, BloodFeast.class, WerewolfBalance.bloodFeastDuration(hero.pointsInTalent(Talent.BLOOD_FEAST)));
+        }
+        BeastRampage.Rampage rampage = hero.buff(BeastRampage.Rampage.class);
+        if (rampage != null) {
+            rampage.extend(WerewolfBalance.RAMPAGE_KILL_EXTENSION
+                    + WerewolfBalance.ENDLESS_EXTENSION_PER_POINT * hero.pointsInTalent(Talent.ENDLESS_RAMPAGE));
+            int shield = WerewolfBalance.BLOOD_ARMOR_PER_POINT * hero.pointsInTalent(Talent.BLOOD_ARMOR);
+            if (shield > 0) Buff.affect(hero, Barrier.class).incShield(shield);
+        }
+    }
+    public static int attackBonus(Hero hero) {
+        if (!isWerewolf(hero)) return 0;
+        int bonus = hero.buff(SlaughterMomentum.class) == null ? 0 : hero.pointsInTalent(Talent.SLAUGHTER_MOMENTUM);
+        Hunger hunger = hero.buff(Hunger.class);
+        if (hunger != null && hunger.isStarving())
+            bonus += WerewolfBalance.starvingDamage(hero.pointsInTalent(Talent.STARVING_FURY));
+        return bonus;
+    }
+    /** Called before the weapon enchantment, so only pre-existing bleeds trigger these benefits. */
+    public static void onClawHit(Hero hero, Char enemy) {
+        if (!isWerewolf(hero) || enemy.alignment != Char.Alignment.ENEMY) return;
+        Bleeding bleed = enemy.buff(Bleeding.class);
+        if (bleed != null) {
+            heal(hero, WerewolfBalance.feastHealing(hero.pointsInTalent(Talent.BLOOD_FEEDING)));
+            if (hero.subClass == HeroSubClass.BLOODFANG) {
+                bleed.extend(bleed.level() * WerewolfBalance.deepWounds(hero.pointsInTalent(Talent.DEEP_WOUNDS)));
+                enemy.needsIncomingDOTUpdate = true;
+                if (Random.Float() < WerewolfBalance.thirstChance(hero.pointsInTalent(Talent.THIRST))) heal(hero, 1);
+            }
+        }
+    }
+    public static float attackSpeed(Hero hero, Char enemy) {
+        if (!isWerewolf(hero)) return 1f;
+        float speed = hero.buff(ChainAssault.class) == null ? 1f : WerewolfBalance.chainSpeed(hero.pointsInTalent(Talent.CHAIN_ASSAULT));
+        if (hero.buff(BeastRampage.Rampage.class) != null) speed *= WerewolfBalance.RAMPAGE_ATTACK_SPEED;
+        if (hero.subClass == HeroSubClass.BLOODFANG && hero.buff(BloodFeast.class) != null
+                && enemy != null && enemy.buff(Bleeding.class) != null) speed *= WerewolfBalance.BLOOD_FEAST_SPEED;
+        return speed;
+    }
+    public static float movementSpeed(Hero hero) {
+        if (!isWerewolf(hero)) return 1f;
+        float speed = hero.buff(HuntingSprint.class) == null ? 1f : WerewolfBalance.MEAT_SPEED;
+        if (hero.buff(BeastRampage.Rampage.class) != null) speed *= WerewolfBalance.RAMPAGE_SPEED;
+        return speed;
+    }
+    public static float scentSpeed(Hero hero, int from, int to) {
+        if (hero.subClass != HeroSubClass.BLOODFANG || !hero.hasTalent(Talent.BLOOD_SCENT)) return 1f;
+        for (Mob mob : Dungeon.level.mobs) {
+            if (mob.alignment == Char.Alignment.ENEMY && mob.isAlive() && Dungeon.level.heroFOV[mob.pos]
+                    && mob.buff(Bleeding.class) != null
+                    && Dungeon.level.trueDistance(to, mob.pos) < Dungeon.level.trueDistance(from, mob.pos))
+                return WerewolfBalance.scentSpeed(hero.pointsInTalent(Talent.BLOOD_SCENT));
+        }
+        return 1f;
+    }
+    public static void hungerChanged(Hero hero, float before, float after) {
+        if (isWerewolf(hero) && before < Hunger.HUNGRY && after >= Hunger.HUNGRY
+                && !hero.werewolfHungerShieldUsed && hero.hasTalent(Talent.HUNGRY_BEAST)) {
+            hero.werewolfHungerShieldUsed = true;
+            Buff.affect(hero, Barrier.class).setShield(WerewolfBalance.hungryShield(hero.pointsInTalent(Talent.HUNGRY_BEAST)));
+        }
+    }
+    public static boolean isMeat(Item item) {
+        return item instanceof MysteryMeat || item instanceof ChargrilledMeat || item instanceof FrozenCarpaccio
+                || item instanceof StewedMeat || item instanceof PhantomMeat;
+    }
+    public static boolean isRation(Item item) {
+        return item.getClass() == Food.class || item instanceof SmallRation || item instanceof SupplyRation;
+    }
+    public static void onFood(Hero hero, Item food) {
+        if (!isWerewolf(hero)) return;
+        Hunger hunger = hero.buff(Hunger.class);
+        if (hunger != null && hunger.hunger() < Hunger.HUNGRY) hero.werewolfHungerShieldUsed = false;
+        if (isMeat(food) && hero.hasTalent(Talent.HUNTING_SPRINT))
+            Buff.prolong(hero, HuntingSprint.class, WerewolfBalance.mealDuration(hero.pointsInTalent(Talent.HUNTING_SPRINT)) + hero.cooldown());
+    }
+    public static int enemyArmor(Hero hero, int dr) {
+        if (isWerewolf(hero) && hero.subClass == HeroSubClass.MOONSHADOW && hero.buff(NeckStrike.class) != null)
+            return Math.round(dr * (1f - WerewolfBalance.neckIgnore(hero.pointsInTalent(Talent.NECK_STRIKE))));
+        return dr;
+    }
+    public static class SlaughterMomentum extends Buff { @Override public int icon() { return BuffIndicator.WEAPON; } }
+    public static class ChainAssault extends Buff { @Override public int icon() { return BuffIndicator.HASTE; } }
+    public static class NeckStrike extends Buff { @Override public int icon() { return BuffIndicator.WEAPON; } }
+    public static class HuntingSprint extends FlavourBuff { @Override public int icon() { return BuffIndicator.HASTE; } }
+    public static class BloodFeast extends FlavourBuff { @Override public int icon() { return BuffIndicator.BLEEDING; } }
+    public static class Afterimage extends FlavourBuff { @Override public int icon() { return BuffIndicator.HASTE; } }
+    public static class HeartHarvestCooldown extends FlavourBuff { { revivePersists = true; } @Override public int icon() { return BuffIndicator.TIME; } }
+}

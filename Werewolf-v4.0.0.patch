+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package com.shatteredpixel.shatteredpixeldungeon.items;
+
+import com.shatteredpixel.shatteredpixeldungeon.actors.Actor;
+import com.shatteredpixel.shatteredpixeldungeon.actors.hero.*;
+import com.shatteredpixel.shatteredpixeldungeon.items.weapon.melee.Claws;
+import com.shatteredpixel.shatteredpixeldungeon.messages.Messages;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.GameScene;
+import com.shatteredpixel.shatteredpixeldungeon.sprites.ItemSpriteSheet;
+import com.shatteredpixel.shatteredpixeldungeon.utils.GLog;
+import com.shatteredpixel.shatteredpixeldungeon.windows.WndBag;
+import java.util.ArrayList;
+
+public class ClawWhetstone extends Item {
+    public static final String AC_APPLY = "APPLY";
+    { image = ItemSpriteSheet.STONE_ENCHANT; stackable = true; bones = true; defaultAction = AC_APPLY; }
+    @Override public boolean isIdentified() { return true; }
+    @Override public boolean isUpgradable() { return false; }
+    @Override public int value() { return WerewolfBalance.WHETSTONE_VALUE * quantity(); }
+    public boolean applyTo(Hero hero, Claws claws) {
+        if (!WerewolfMechanics.isWerewolf(hero) || claws == null || !claws.isEquipped(hero)
+                || !hero.belongings.contains(this)) return false;
+        detach(hero.belongings.backpack);
+        claws.sharpen();
+        return true;
+    }
+    @Override public ArrayList<String> actions(Hero hero) {
+        ArrayList<String> actions = super.actions(hero);
+        if (WerewolfMechanics.isWerewolf(hero)) actions.add(AC_APPLY);
+        return actions;
+    }
+    @Override public void execute(final Hero hero, String action) {
+        super.execute(hero, action);
+        if (!AC_APPLY.equals(action) || !WerewolfMechanics.isWerewolf(hero)) return;
+        GameScene.selectItem(new WndBag.ItemSelector() {
+            @Override public String textPrompt() { return Messages.get(ClawWhetstone.class, "prompt"); }
+            @Override public boolean itemSelectable(Item item) { return item instanceof Claws && item.isEquipped(hero); }
+            @Override public void onSelect(Item item) {
+                if (!itemSelectable(item) || !applyTo(hero, (Claws)item)) return;
+                hero.sprite.operate(hero.pos);
+                GLog.p(Messages.get(ClawWhetstone.class, "applied"));
+                hero.spendAndNext(Actor.TICK);
+            }
+        });
+    }
+    public static class Recipe extends com.shatteredpixel.shatteredpixeldungeon.items.Recipe.SimpleRecipe {
+        {
+            inputs = new Class[]{IronScraps.class};
+            inQuantity = new int[]{WerewolfBalance.WHETSTONE_SCRAP_COST};
+            cost = WerewolfBalance.WHETSTONE_ENERGY_COST;
+            output = ClawWhetstone.class;
+            outQuantity = 1;
+        }
+    }
+}

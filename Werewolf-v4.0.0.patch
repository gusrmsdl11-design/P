+        equal(WerewolfMechanics.attackSpeed(hero, null), 1.3, "next attack speed");
+        // Hero.attack(null) follows the actual consume-on-attempt wrapper without rendering combat.
+        hero.attack(null);
+        equal(WerewolfMechanics.attackBonus(hero), 0, "momentum consumed once");
+        equal(WerewolfMechanics.attackSpeed(hero, null), 1, "chain consumed once");
+        rank(hero, Talent.BLOOD_FEEDING, 2);

+        hero.belongings.armor = new FixedArmor();
+        equal(hero.drRoll(), 10, "final armor DR is two thirds");
+        Buff.prolong(hero, BeastRampage.Rampage.class, 6);
+        equal(hero.drRoll(), 8, "rampage armor uses one final rounding");

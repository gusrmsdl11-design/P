+/** The body weapon. Ordinary Weapon enchantment procs and reach remain intact. */
+public class Claws extends MeleeWeapon {
+    public static final String AC_HEART = "HEART_PIERCE", AC_POUNCE = "POUNCE";
+    public float heartCharge = WerewolfBalance.HEART_MAX_CHARGE;
+    public float pounceCharge = WerewolfBalance.POUNCE_MAX_CHARGE;
+    // Only live during a synchronous attack callback; never a persistent ability state.
+    private boolean heartStrike;
+
+    {
+        tier = 1;
+        image = ItemSpriteSheet.GLOVES;
+        unique = true;
+        bones = false;
+        levelKnown = cursedKnown = true;
+        defaultAction = AC_HEART;
+        usesTargeting = true;
+    }
+    @Override public int min(int level) { return WerewolfBalance.CLAW_MIN + WerewolfBalance.CLAW_MIN_PER_LEVEL * level; }
+    @Override public int max(int level) { return WerewolfBalance.CLAW_MAX + WerewolfBalance.CLAW_MAX_PER_LEVEL * level; }
+    @Override public int STRReq(int level) { return WerewolfBalance.CLAW_STRENGTH; }
+    @Override public boolean isUpgradable() { return false; }
+    @Override public boolean isIdentified() { return true; }
+    @Override public boolean keptThroughLostInventory() { return true; }
+    @Override public int value() { return 0; }
+    @Override public Item upgrade() { return this; }
+    @Override public Item upgrade(boolean enchant) { return this; }
+    @Override public Weapon enchant(Enchantment enchantment) { return this; }
+    @Override public void doDrop(Hero hero) {}
+    @Override public void doThrow(Hero hero) {}
+    @Override public boolean doUnequip(Hero hero, boolean collect, boolean single) { return false; }
+    @Override public String defaultAction() { return AC_HEART; }
+    @Override public void activate(Char owner) {
+        super.activate(owner);
+        if (owner instanceof Hero && WerewolfMechanics.isWerewolf((Hero)owner)) Buff.affect(owner, ClawCharger.class);
+    }
+    public void growTo(long kills) {
+        // Item's level setter changes only the permanent level; it cannot strip an enchantment.
+        super.level(Math.toIntExact(kills / WerewolfBalance.CLAW_KILLS));
+    }
+    public void sharpen() {
+        super.enchant(Enchantment.random(enchantment == null ? null : enchantment.getClass()));
+        updateQuickslot();
+    }
+    @Override public ArrayList<String> actions(Hero hero) {
+        ArrayList<String> result = new ArrayList<>();
+        if (WerewolfMechanics.isWerewolf(hero) && isEquipped(hero)) {
+            result.add(AC_HEART);
+            if (hero.subClass == HeroSubClass.MOONSHADOW) result.add(AC_POUNCE);
+        }
+        return result;
+    }
+    @Override public void execute(final Hero hero, String action) {
+        if (!WerewolfMechanics.isWerewolf(hero) || !isEquipped(hero)
+                || (!AC_HEART.equals(action) && !AC_POUNCE.equals(action))) return;
+        if (AC_POUNCE.equals(action) && hero.subClass != HeroSubClass.MOONSHADOW) return;
+        super.execute(hero, action);
+        final boolean pounce = AC_POUNCE.equals(action);
+        if ((pounce ? pounceCharge : heartCharge) < (pounce ? WerewolfBalance.POUNCE_COST : WerewolfBalance.HEART_COST)) {
+            GLog.w(Messages.get(this, "no_charge"));
+            return;
+        }
+        GameScene.selectCell(new CellSelector.Listener() {
+            @Override public void onSelect(Integer cell) {
+                if (cell == null) return;
+                if (pounce) pounce(hero, cell); else pierce(hero, cell);
+            }
+            @Override public String prompt() { return Messages.get(Claws.class, pounce ? "pounce_prompt" : "heart_prompt"); }
+        });
+    }
+    private boolean validEnemy(Hero hero, Char enemy) {
+        return enemy != null && enemy != hero && enemy.isAlive() && enemy.alignment == Char.Alignment.ENEMY
+                && Dungeon.level.heroFOV[enemy.pos] && !hero.isCharmedBy(enemy);
+    }
+    private void pierce(final Hero hero, int cell) {
+        final Char enemy = Actor.findChar(cell);
+        if (!validEnemy(hero, enemy) || !hero.canAttack(enemy)) {
+            GLog.w(Messages.get(this, "invalid_target"));
+            return;
+        }
+        if (heartCharge < WerewolfBalance.HEART_COST) return;
+        final float delay = hero.attackDelay() / WerewolfMechanics.attackSpeed(hero, enemy);
+        final boolean bleedingBefore = enemy.buff(Bleeding.class) != null;
+        heartCharge -= WerewolfBalance.HEART_COST;
+        updateQuickslot();
+        hero.busy();
+        hero.sprite.attack(enemy.pos, new Callback() {
+            @Override public void call() {
+                boolean hit;
+                heartStrike = true;
+                try {
+                    hit = hero.attack(enemy, 1f, Random.IntRange(WerewolfBalance.HEART_BONUS_MIN, WerewolfBalance.HEART_BONUS_MAX), 1f);
+                } finally { heartStrike = false; }
+                tryHeartHarvest(hero, bleedingBefore, hit && !enemy.isAlive());
+                Invisibility.dispel();
+                updateQuickslot();
+                hero.spendAndNext(delay);
+            }
+        });
+    }
+    public void tryHeartHarvest(Hero hero, boolean bleedingBefore, boolean killed) {
+        if (WerewolfMechanics.isWerewolf(hero) && isEquipped(hero) && bleedingBefore && killed
+                && hero.hasTalent(Talent.HEART_HARVEST) && hero.buff(WerewolfMechanics.HeartHarvestCooldown.class) == null) {
+            heartCharge = WerewolfBalance.replenish(heartCharge,
+                    WerewolfBalance.harvestCharge(hero.pointsInTalent(Talent.HEART_HARVEST)), WerewolfBalance.HEART_MAX_CHARGE);
+            Buff.affect(hero, WerewolfMechanics.HeartHarvestCooldown.class, WerewolfBalance.HARVEST_COOLDOWN);
+        }
+    }
+    @Override public int proc(Char attacker, Char defender, int damage) {
+        if (attacker instanceof Hero && WerewolfMechanics.isWerewolf((Hero)attacker)) {
+            Hero hero = (Hero)attacker;
+            Bleeding existing = defender.buff(Bleeding.class);
+            float previousBleed = existing == null ? 0f : existing.level();
+            WerewolfMechanics.onClawHit(hero, defender);
+            if (heartStrike) {
+                if (previousBleed > 0 && hero.subClass == HeroSubClass.BLOODFANG && hero.hasTalent(Talent.REOPEN_WOUNDS)) {
+                    // Immediate extra ticks do not call Bleeding.act() or reduce its remaining potency.
+                    defender.damage(Math.round(previousBleed) * hero.pointsInTalent(Talent.REOPEN_WOUNDS), hero);
+                }
+                if (defender.isAlive()) Buff.affect(defender, Bleeding.class).set(WerewolfBalance.HEART_BLEED, Claws.class);
+            }
+            BeastRampage.PreyMark mark = defender.buff(BeastRampage.PreyMark.class);
+            if (mark != null) {
+                if (hero.buff(BeastRampage.Rampage.class) != null)
+                    damage += WerewolfBalance.ROAR_DAMAGE_PER_POINT * hero.pointsInTalent(Talent.HUNTING_ROAR);
+                mark.detach();
+            }
+        }
+        return defender.isAlive() ? super.proc(attacker, defender, damage) : damage;
+    }
+    private void pounce(final Hero hero, int cell) {
+        if (hero.rooted || cell == hero.pos || !Dungeon.level.heroFOV[cell]
+                || Dungeon.level.distance(hero.pos, cell) > WerewolfBalance.POUNCE_RANGE + hero.pointsInTalent(Talent.LONG_LEAP)) {
+            GLog.w(Messages.get(this, "invalid_target"));
+            return;
+        }
+        final Char enemy = Actor.findChar(cell);
+        if (enemy != null && !validEnemy(hero, enemy)) return;
+        Ballistica route = new Ballistica(hero.pos, cell, Ballistica.STOP_TARGET | Ballistica.STOP_SOLID | Ballistica.STOP_CHARS);
+        if (route.collisionPos != cell) {
+            GLog.w(Messages.get(this, "invalid_target"));
+            return;
+        }
+        final int dest = enemy == null ? cell : route.path.get(Math.max(0, route.dist - 1));
+        if (!Dungeon.level.passable[dest] || Dungeon.level.pit[dest]
+                || (Actor.findChar(dest) != null && dest != hero.pos) || pounceCharge < WerewolfBalance.POUNCE_COST) return;
+        pounceCharge -= WerewolfBalance.POUNCE_COST;
+        updateQuickslot();
+        hero.busy();
+        hero.sprite.jump(hero.pos, dest, new Callback() {
+            @Override public void call() {
+                hero.move(dest);
+                Dungeon.level.occupyCell(hero);
+                Dungeon.observe();
+                GameScene.updateFog();
+                if (!hero.isAlive()) { hero.next(); return; }
+                if (hero.hasTalent(Talent.NECK_STRIKE)) Buff.affect(hero, WerewolfMechanics.NeckStrike.class);
+                float time = WerewolfBalance.POUNCE_TIME;
+                if (enemy != null && validEnemy(hero, enemy) && hero.canAttack(enemy)) {
+                    time = hero.attackDelay() / WerewolfMechanics.attackSpeed(hero, enemy);
+                    boolean hit = hero.attack(enemy, 1f, WerewolfBalance.pounceDamage(hero.pointsInTalent(Talent.HUNT_BEGINS)), 1f);
+                    if (hit && !enemy.isAlive()) pounceCharge = WerewolfBalance.replenish(pounceCharge,
+                            WerewolfBalance.pounceRefund(hero.pointsInTalent(Talent.CONTINUOUS_HUNT)), WerewolfBalance.POUNCE_MAX_CHARGE);
+                }
+                if (hero.hasTalent(Talent.AFTERIMAGE)) Buff.prolong(hero, WerewolfMechanics.Afterimage.class,
+                        WerewolfBalance.afterimageDuration(hero.pointsInTalent(Talent.AFTERIMAGE)) + time);
+                Invisibility.dispel();
+                updateQuickslot();
+                hero.spendAndNext(time);
+            }
+        });
+    }
+    @Override public String status() { return String.format(Locale.ENGLISH, "%.1f/%.0f", heartCharge, WerewolfBalance.HEART_MAX_CHARGE); }
+    @Override public String info() {
+        String result = super.info() + "\n\n" + Messages.get(this, "charge_info", status());
+        if (WerewolfMechanics.isWerewolf(Dungeon.hero)) {
+            result += "\n\n" + Messages.get(this, "kills_info", Dungeon.hero.werewolfKills);
+            if (Dungeon.hero.subClass == HeroSubClass.MOONSHADOW)
+                result += "\n\n" + Messages.get(this, "pounce_info", String.format(Locale.ENGLISH, "%.1f/%.0f", pounceCharge, WerewolfBalance.POUNCE_MAX_CHARGE));
+        }
+        return result;
+    }
+    @Override public void storeInBundle(Bundle bundle) {
+        super.storeInBundle(bundle);
+        bundle.put("ww_heart_charge", heartCharge);
+        bundle.put("ww_pounce_charge", pounceCharge);
+    }
+    @Override public void restoreFromBundle(Bundle bundle) {
+        super.restoreFromBundle(bundle);
+        heartCharge = bundle.contains("ww_heart_charge") ? bundle.getFloat("ww_heart_charge") : WerewolfBalance.HEART_MAX_CHARGE;
+        pounceCharge = bundle.contains("ww_pounce_charge") ? bundle.getFloat("ww_pounce_charge") : WerewolfBalance.POUNCE_MAX_CHARGE;
+        heartCharge = Math.max(0f, Math.min(WerewolfBalance.HEART_MAX_CHARGE, heartCharge));
+        pounceCharge = Math.max(0f, Math.min(WerewolfBalance.POUNCE_MAX_CHARGE, pounceCharge));
+    }
+    /** A single persisted hero buff ticks the item charges; uses Wand.Charger's timing model. */
+    public static class ClawCharger extends Buff {
+        { revivePersists = true; }
+        @Override public boolean act() {
+            if (!(target instanceof Hero) || !WerewolfMechanics.isWerewolf((Hero)target)) { detach(); return true; }
+            Hero hero = (Hero)target;
+            Claws claws = WerewolfMechanics.claws(hero);
+            if (claws != null && Regeneration.regenOn()) {
+                claws.heartCharge = WerewolfBalance.replenish(claws.heartCharge,
+                        WerewolfBalance.heartRecharge(claws.heartCharge), WerewolfBalance.HEART_MAX_CHARGE);
+                if (hero.subClass == HeroSubClass.MOONSHADOW)
+                    claws.pounceCharge = WerewolfBalance.replenish(claws.pounceCharge,
+                            1f / WerewolfBalance.POUNCE_RECHARGE_TURNS, WerewolfBalance.POUNCE_MAX_CHARGE);
+                updateQuickslot();
+            }
+            spend(TICK);
+            return true;
+        }
+    }
+}

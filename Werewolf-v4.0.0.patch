+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package com.shatteredpixel.shatteredpixeldungeon.actors.hero.abilities.werewolf;
+
+import com.shatteredpixel.shatteredpixeldungeon.Dungeon;
+import com.shatteredpixel.shatteredpixeldungeon.actors.Actor;
+import com.shatteredpixel.shatteredpixeldungeon.actors.buffs.*;
+import com.shatteredpixel.shatteredpixeldungeon.actors.hero.*;
+import com.shatteredpixel.shatteredpixeldungeon.actors.hero.abilities.ArmorAbility;
+import com.shatteredpixel.shatteredpixeldungeon.actors.mobs.Mob;
+import com.shatteredpixel.shatteredpixeldungeon.items.armor.ClassArmor;
+import com.shatteredpixel.shatteredpixeldungeon.items.scrolls.ScrollOfRage;
+import com.shatteredpixel.shatteredpixeldungeon.ui.BuffIndicator;
+import com.shatteredpixel.shatteredpixeldungeon.ui.HeroIcon;
+
+public class BeastRampage extends ArmorAbility {
+    { baseChargeUse = WerewolfBalance.RAMPAGE_COST; }
+    @Override protected void activate(ClassArmor armor, Hero hero, Integer target) {
+        if (!WerewolfMechanics.isWerewolf(hero) || armor.charge < chargeUse(hero)) return;
+        ScrollOfRage.enrage(hero);
+        if (hero.hasTalent(Talent.HUNTING_ROAR)) {
+            for (Mob mob : Dungeon.level.mobs) {
+                if (Dungeon.level.heroFOV[mob.pos] && mob.buff(Amok.class) != null)
+                    Buff.prolong(mob, PreyMark.class, WerewolfBalance.ROAR_MARK_DURATION);
+            }
+        }
+        Buff.prolong(hero, Rampage.class, WerewolfBalance.RAMPAGE_DURATION
+                + WerewolfBalance.ENDLESS_DURATION_PER_POINT * hero.pointsInTalent(Talent.ENDLESS_RAMPAGE));
+        armor.charge -= chargeUse(hero);
+        armor.updateQuickslot();
+        hero.sprite.operate(hero.pos);
+        Invisibility.dispel();
+        hero.spendAndNext(Actor.TICK);
+    }
+    @Override public int icon() { return HeroIcon.NATURES_POWER; }
+    @Override public Talent[] talents() {
+        return new Talent[]{Talent.ENDLESS_RAMPAGE, Talent.BLOOD_ARMOR, Talent.HUNTING_ROAR, Talent.HEROIC_ENERGY};
+    }
+    public static class Rampage extends FlavourBuff {
+        { type = buffType.POSITIVE; }
+        public void extend(float turns) { spend(turns); }
+        @Override public void detach() {
+            if (target instanceof Hero && Dungeon.level != null) {
+                for (Mob mob : Dungeon.level.mobs) Buff.detach(mob, PreyMark.class);
+            }
+            super.detach();
+        }
+        @Override public int icon() { return BuffIndicator.FURY; }
+    }
+    public static class PreyMark extends FlavourBuff {
+        { type = buffType.NEGATIVE; }
+        @Override public int icon() { return BuffIndicator.BLEEDING; }
+    }
+}

+package com.shatteredpixel.shatteredpixeldungeon.actors.hero;
+
+import java.util.Random;
+
+/** Runs against the real tuning/formula class using only a JDK. No copied production formulas. */
+public final class WerewolfBalanceChecks {
+    private static int checks;
+    private static void check(boolean value, String message) {
+        checks++;
+        if (!value) throw new AssertionError(message);
+    }
+    private static void equal(long wanted, long actual, String message) { check(wanted == actual, message + ": " + actual); }
+    private static void near(float wanted, float actual, String message) { check(Math.abs(wanted - actual) < 0.0001f, message); }
+    public static void main(String[] args) {
+        int[] intervals = {WerewolfBalance.HEALTH_KILLS, WerewolfBalance.MEAT_KILLS,
+                WerewolfBalance.CLAW_KILLS, WerewolfBalance.WHETSTONE_KILLS};
+        long[] hundred = {20, 5, 2, 1};
+        for (int i = 0; i < intervals.length; i++) {
+            int step = intervals[i];
+            equal(hundred[i], WerewolfBalance.milestones(0, 100, step), "100-kill reward");
+            equal(0, WerewolfBalance.milestones(0, step - 1, step), "before first threshold");
+            equal(1, WerewolfBalance.milestones(step - 1, step, step), "at threshold");
+            equal(0, WerewolfBalance.milestones(step, step, step), "load must not replay rewards");
+            equal(1, WerewolfBalance.milestones(2L * step - 1, 2L * step, step), "repeated threshold");
+            equal(3, WerewolfBalance.milestones(step - 1, 3L * step, step), "batch crosses three thresholds");
+            // Partition invariance: random batch processing must match an independent per-kill oracle.
+            Random random = new Random(700 + step);
+            for (int trial = 0; trial < 1000; trial++) {
+                int before = random.nextInt(10000), after = before + random.nextInt(1000);
+                long oracle = 0;
+                for (int kill = before + 1; kill <= after; kill++) if (kill % step == 0) oracle++;
+                equal(oracle, WerewolfBalance.milestones(before, after, step), "batch vs individual kills");
+                int middle = before + (after - before) / 2;
+                equal(oracle, WerewolfBalance.milestones(before, middle, step)
+                        + WerewolfBalance.milestones(middle, after, step), "save/load partition");
+            }
+            equal(10, WerewolfBalance.milestones(4_000_000_000L, 4_000_000_000L + step * 10L, step), "long counter");
+        }
+        equal(4, WerewolfBalance.milestones(99, 251, 50), "99->251 claw levels");
+        equal(2, WerewolfBalance.milestones(99, 251, 100), "99->251 whetstones");
+        equal(8, WerewolfBalance.milestones(99, 251, WerewolfBalance.MEAT_KILLS), "99->251 meat");
+        equal(31, WerewolfBalance.milestones(99, 251, 5), "99->251 health");
+        equal(20000, WerewolfBalance.milestones(0, 1000000, 50), "no farming soft cap");
+        equal(10, WerewolfBalance.armorRoll(15, false), "15 armor -> 10");
+        equal(8, WerewolfBalance.armorRoll(15, true), "rage armor rounding");
+        equal(0, WerewolfBalance.armorRoll(-5, false), "negative encumbered armor");
+        for (int armor = 0; armor < 1000; armor++) {
+            int regular = WerewolfBalance.armorRoll(armor, false), rage = WerewolfBalance.armorRoll(armor, true);
+            check(rage >= 0 && rage <= regular && regular <= armor, "armor order");
+        }
+        equal(0, WerewolfBalance.meatStock(0), "unlearned provisions");
+        equal(2, WerewolfBalance.meatStock(1), "rank 1 provisions");
+        equal(3, WerewolfBalance.meatStock(2), "rank 2 provisions");
+        equal(3, WerewolfBalance.meatStock(20), "provisions max 3");
+        equal(2, WerewolfBalance.rationMeat(0f), "ration lower range");
+        equal(2, WerewolfBalance.rationMeat(0.49999f), "ration below half");
+        equal(1, WerewolfBalance.rationMeat(0.5f), "ration threshold");
+        equal(1, WerewolfBalance.rationMeat(0.99999f), "ration upper range");
+        equal(1, WerewolfBalance.scrapYield(1, -3), "cursed weapon salvage");
+        equal(7, WerewolfBalance.scrapYield(5, 4), "tier 5 +4 salvage");
+        equal(5, WerewolfBalance.scrapYield(3, 5), "partial upgrade bonus");
+        near(0.5f, WerewolfBalance.harvestCharge(1), "half charge retained");
+        near(1f, WerewolfBalance.harvestCharge(2), "full charge retained");
+        near(20f, WerewolfBalance.HARVEST_COOLDOWN, "harvest cooldown");
+        near(2.75f, WerewolfBalance.replenish(2.25f, 0.5f, 3f), "fractional charge");
+        near(3f, WerewolfBalance.replenish(2.75f, 1f, 3f), "charge overflow");
+        float charge = 0;
+        for (int turn = 0; turn < 200; turn++) {
+            float before = charge;
+            charge = WerewolfBalance.replenish(charge, WerewolfBalance.heartRecharge(charge, 3f), 3f);
+            check(charge >= before && charge <= 3f, "recharge monotonic and bounded");
+        }
+        near(3f, charge, "eventually fully charged");
+        near(3f, WerewolfBalance.heartCapacity(0), "starting heart capacity");
+        near(3f, WerewolfBalance.heartCapacity(1), "odd claw level does not add a slot");
+        near(4f, WerewolfBalance.heartCapacity(2), "two claw levels add one slot");
+        near(4f, WerewolfBalance.heartCapacity(3), "next odd level keeps capacity");
+        near(5f, WerewolfBalance.heartCapacity(4), "four claw levels add two slots");
+        near(503f, WerewolfBalance.heartCapacity(1000), "heart capacity has no ten-charge cap");
+        check(WerewolfBalance.heartRecharge(4f, 5f) > 0f, "charge above three still regenerates");
+        near(0.3f, WerewolfBalance.deepWounds(3), "third deep wounds rank");
+        near(1.75f, WerewolfBalance.scentSpeed(3), "third scent rank");
+        near(0.4f, WerewolfBalance.thirstChance(3), "third thirst rank");
+        near(7f, WerewolfBalance.bloodFeastDuration(3), "third blood feast rank");
+        equal(6, WerewolfBalance.pounceDamage(3), "third pounce damage rank");
+        near(0.75f, WerewolfBalance.pounceRefund(3), "third pounce refund rank");
+        near(4f, WerewolfBalance.afterimageDuration(3), "third afterimage rank");
+        near(0.75f, WerewolfBalance.neckIgnore(3), "third armor ignore rank");
+        equal(3, WerewolfBalance.REFINED_IRON_SCRAP_COST, "three powder fit the alchemy slots");
+        equal(3, WerewolfBalance.WHETSTONE_IRON_COST, "three refined iron fit the alchemy slots");
+        equal(0, WerewolfBalance.REFINED_IRON_ENERGY_COST, "refining powder is free");
+        near(0.25f, WerewolfBalance.pounceRefund(1), "pounce refund rank1");
+        near(0.5f, WerewolfBalance.pounceRefund(2), "pounce refund rank2");
+        near(1.2f, WerewolfBalance.chainSpeed(1), "chain rank1");
+        near(1.3f, WerewolfBalance.chainSpeed(2), "chain rank2");
+        near(150f, WerewolfBalance.PASTY_ENERGY, "one hunger band");
+        near(40f, 50f / WerewolfBalance.SPAWN_FACTOR, "25 percent spawn rate");
+        System.out.println("PASS: " + checks + " balance/boundary assertions");
+    }
+}

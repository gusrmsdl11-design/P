+    private static Hero fixture(HeroClass cls) {
+        Actor.clear();
+        ActionIndicator.clearAction();
+        Dungeon.challenges = 0;
+        Dungeon.depth = 5; // Avoid ordinary resource allocation in the synthetic boss-depth map.
+        Dungeon.branch = 0;

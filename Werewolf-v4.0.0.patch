+        level.create();
+        hero.pos = 24;
+        return hero;
+    }
+    private static void rank(Hero hero, Talent talent, int points) {
+        for (LinkedHashMap<Talent, Integer> tier : hero.talents) {
+            if (tier.containsKey(talent)) { tier.put(talent, points); return; }
+        }
+        throw new AssertionError("Talent is not offered: " + talent);
+    }
+    private static int count(Hero hero, Class<? extends Item> type) {
+        int count = 0;
+        for (Item item : hero.belongings.backpack) if (type.isInstance(item)) count += item.quantity();
+        return count;
+    }
+    private static Bundle roundTrip(Bundle original) throws Exception {
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        check(Bundle.write(original, bytes), "Bundle write");
+        return Bundle.read(new ByteArrayInputStream(bytes.toByteArray()));
+    }
+    private static Hero reload(Hero hero) throws Exception {

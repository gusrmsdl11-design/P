+        Hero hero = new Hero();
+        Dungeon.hero = hero;
+        hero.heroClass = cls;
+        Talent.initClassTalents(hero);
+        if (cls == HeroClass.WEREWOLF) {
+            hero.belongings.weapon = new Claws();
+            hero.belongings.weapon.activate(hero);
+        }
+        TestLevel level = new TestLevel();

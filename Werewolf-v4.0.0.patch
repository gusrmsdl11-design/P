+        WerewolfMechanics.onKill(hero, new Victim());
+        equal(rampage.cooldown(), 7, "kill extends rampage");
+        equal(hero.buff(Barrier.class).shielding(), 4, "rampage kill shield");
+        equal(WerewolfMechanics.movementSpeed(hero), 1.5, "rampage movement");
+        equal(WerewolfMechanics.attackSpeed(hero, null), 1.3, "rampage attack speed");

+    private static void harvestAndRampage() throws Exception {
+        Hero hero = fixture(HeroClass.WEREWOLF);
+        rank(hero, Talent.HEART_HARVEST, 2);
+        Claws claws = WerewolfMechanics.claws(hero);
+        claws.heartCharge = 0;
+        claws.tryHeartHarvest(hero, false, true);
+        equal(claws.heartCharge, 0, "harvest requires previous bleeding");
+        claws.tryHeartHarvest(hero, true, true);
+        equal(claws.heartCharge, 1, "harvest refund");
+        claws.tryHeartHarvest(hero, true, true);
+        equal(claws.heartCharge, 1, "harvest cooldown blocks repeat");
+        hero = reload(hero);
+        claws = WerewolfMechanics.claws(hero);
+        WerewolfMechanics.HeartHarvestCooldown cooldown = hero.buff(WerewolfMechanics.HeartHarvestCooldown.class);
+        equal(cooldown.cooldown(), 20, "harvest cooldown survives save");
+        cooldown.fixTime(19);
+        claws.tryHeartHarvest(hero, true, true);
+        equal(claws.heartCharge, 1, "no refund before turn twenty");
+        cooldown.fixTime(1);
+        cooldown.act(); // Simulate the actor being scheduled at its due time.
+        claws.tryHeartHarvest(hero, true, true);
+        equal(claws.heartCharge, 2, "refund allowed after expiry");
+        hero.armorAbility = new BeastRampage();
+        Talent.initArmorTalents(hero);
+        rank(hero, Talent.BLOOD_ARMOR, 2);

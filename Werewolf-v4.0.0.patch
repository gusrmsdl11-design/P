+
+    private static void floorsAndClasses() throws Exception {
+        Hero warrior = fixture(HeroClass.WARRIOR);
+        float normalRespawn = Dungeon.level.respawnCooldown();
+        WerewolfMechanics.addKills(warrior, 100);
+        equal(warrior.werewolfKills, 0, "other class does not grow");
+        warrior.belongings.armor = new FixedArmor();
+        equal(warrior.drRoll(), 15, "other class retains armor");
+        for (int points = 0; points <= 2; points++) {
+            Hero hero = fixture(HeroClass.WEREWOLF);
+            rank(hero, Talent.MEAT_STOCK, points);
+            TestLevel fresh = new TestLevel();
+            Dungeon.level = fresh;
+            fresh.create();
+            int expected = points == 0 ? 0 : points + 1;
+            equal(fresh.meatCount(), expected, "fresh floor meat at rank " + points);
+            fresh.provisions();
+            equal(fresh.meatCount(), expected, "repeat call cannot add meat");
+            Bundle saved = new Bundle();
+            fresh.storeInBundle(saved);
+            TestLevel loaded = new TestLevel();
+            loaded.restoreFromBundle(roundTrip(saved));
+            Dungeon.level = loaded;
+            loaded.provisions();
+            equal(loaded.meatCount(), expected, "loaded/revisited floor cannot add meat");
+            equal(loaded.respawnCooldown() * 1.25, normalRespawn, "werewolf spawn rate only");
+        }
+        for (HeroSubClass sub : new HeroSubClass[]{HeroSubClass.BLOODFANG, HeroSubClass.MOONSHADOW}) {
+            Hero hero = fixture(HeroClass.WEREWOLF);
+            hero.subClass = sub;
+            Talent.initSubclassTalents(hero);
+            equal(hero.talents.get(2).size(), 5, "five subclass talents");
+            check(hero.talents.get(2).containsKey(sub == HeroSubClass.BLOODFANG ? Talent.DEEP_WOUNDS : Talent.LONG_LEAP),
+                    "correct subclass tree");
+            check(!hero.talents.get(2).containsKey(sub == HeroSubClass.BLOODFANG ? Talent.LONG_LEAP : Talent.DEEP_WOUNDS),
+                    "other subclass absent");
+            for (Talent talent : hero.talents.get(2).keySet()) equal(talent.maxPoints(), 2, "two subclass ranks");
+        }
+    }
+
+    public static class Victim extends Mob { { HP = HT = 20; EXP = 0; } }
+    public static class FixedArmor extends ClothArmor {
+        @Override public int DRMin(int level) { return 15; }
+        @Override public int DRMax(int level) { return 15; }
+        @Override public int STRReq(int level) { return 10; }
+    }
+    public static class TestMeat extends MysteryMeat { public void feed(Hero hero) { satisfy(hero); } }
+    public static class TestPasty extends Pasty { public void feed(Hero hero) { satisfy(hero); } }
+    public static class TestLevel extends Level {
+        @Override protected boolean build() {
+            setSize(7, 7);
+            Arrays.fill(map, Terrain.WALL);
+            for (int y = 1; y < 6; y++) for (int x = 1; x < 6; x++) map[y*7+x] = Terrain.EMPTY;
+            return true;
+        }
+        @Override protected void createMobs() {}
+        @Override protected void createItems() {}
+        public void provisions() { createWerewolfProvisions(); }
+        public int meatCount() {
+            int amount = 0;
+            for (Heap heap : heaps.valueList()) for (Item item : heap.items)
+                if (item instanceof MysteryMeat) amount += item.quantity();
+            return amount;
+        }
+    }
+
+    /** Minimal test IO: real libGDX FileHandle/translation loading, memory preferences, no display. */
+    private static void platform() {
+        GdxNativesLoader.load();
+        final File assets = new File(System.getProperty("werewolf.assets", "core/src/main/assets"));
+        final File data = new File(System.getProperty("werewolf.testData", "build/werewolf-test-data"));
+        if (!data.isDirectory() && !data.mkdirs()) throw new IllegalStateException("Cannot create test data directory");
+        final Map<String, Object> preferences = new HashMap<>();
+        Preferences prefs = (Preferences)Proxy.newProxyInstance(Preferences.class.getClassLoader(), new Class[]{Preferences.class},
+                (proxy, method, args) -> {
+                    String name = method.getName();
+                    if (name.equals("contains")) return preferences.containsKey(args[0]);
+                    if (name.equals("clear")) { preferences.clear(); return null; }
+                    if (name.equals("remove")) { preferences.remove(args[0]); return null; }
+                    if (name.equals("flush")) return null;
+                    if (name.equals("get") && (args == null || args.length == 0)) return preferences;
+                    if (name.startsWith("put")) {
+                        if (args.length == 1) preferences.putAll((Map<String, ?>)args[0]);
+                        else preferences.put((String)args[0], args[1]);
+                        return proxy;
+                    }
+                    if (name.startsWith("get") && args != null)
+                        return preferences.getOrDefault(args[0], args.length > 1 ? args[1] : defaultValue(method.getReturnType()));
+                    return defaultValue(method.getReturnType());
+                });
+        GameSettings.set(prefs);
+        Gdx.app = (Application)Proxy.newProxyInstance(Application.class.getClassLoader(), new Class[]{Application.class},
+                (proxy, method, args) -> {
+                    if (method.getName().equals("getType")) return Application.ApplicationType.HeadlessDesktop;
+                    if (method.getName().equals("getPreferences")) return prefs;
+                    if (method.getName().equals("postRunnable")) { ((Runnable)args[0]).run(); return null; }
+                    return defaultValue(method.getReturnType());
+                });
+        Gdx.files = (Files)Proxy.newProxyInstance(Files.class.getClassLoader(), new Class[]{Files.class},
+                (proxy, method, args) -> {
+                    if (method.getReturnType() == FileHandle.class) {
+                        File base = method.getName().equals("internal") ? assets : data;
+                        File path = new File((String)args[0]);
+                        return new FileHandle(path.isAbsolute() ? path : new File(base, path.toString()));
+                    }
+                    return defaultValue(method.getReturnType());
+                });
+        FileUtils.setDefaultFileProperties(Files.FileType.Absolute, data.getAbsolutePath() + File.separator);
+        Game.version = "4.0.0-werewolf.1-INDEV";
+        Game.versionCode = 912;
+        Random.pushGenerator(897123L);
+    }
+    private static Object defaultValue(Class<?> type) {
+        if (type == boolean.class) return false;
+        if (type == int.class) return 0;
+        if (type == long.class) return 0L;
+        if (type == float.class) return 0f;
+        if (type == double.class) return 0d;
+        if (type == String.class) return "";
+        return null;
+    }
+}
diff --git a/tools/ParseJava.java b/tools/ParseJava.java
new file mode 100644
index 0000000..d715c74
--- /dev/null
+++ b/tools/ParseJava.java
@@ -0,0 +1,25 @@
+import com.sun.source.util.JavacTask;
+import javax.tools.*;
+import java.nio.file.*;
+import java.util.*;
+
+/** Dependency-free syntax check. This is not a replacement for Gradle compilation. */
+public class ParseJava {
+    public static void main(String[] args) throws Exception {
+        List<java.io.File> files = new ArrayList<>();
+        for (String arg : args) try (var paths = Files.walk(Path.of(arg))) {
+            paths.filter(p -> p.toString().endsWith(".java")).forEach(p -> files.add(p.toFile()));
+        }
+        JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+        DiagnosticCollector<JavaFileObject> diagnostics = new DiagnosticCollector<>();
+        try (StandardJavaFileManager fm = compiler.getStandardFileManager(diagnostics, null, java.nio.charset.StandardCharsets.UTF_8)) {
+            JavacTask task = (JavacTask) compiler.getTask(null, fm, diagnostics,
+                    List.of("-proc:none", "--release", "11"), null, fm.getJavaFileObjectsFromFiles(files));
+            task.parse();
+            long errors = diagnostics.getDiagnostics().stream().filter(d -> d.getKind() == Diagnostic.Kind.ERROR).count();
+            diagnostics.getDiagnostics().forEach(System.out::println);
+            System.out.println("Parsed " + files.size() + " Java files; errors=" + errors);
+            if (errors != 0) System.exit(1);
+        }
+    }
+}
diff --git a/tools/check-werewolf-integration.py b/tools/check-werewolf-integration.py
new file mode 100644
index 0000000..6ced7b1
--- /dev/null
+++ b/tools/check-werewolf-integration.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Source-contract checks. These are explicitly NOT device/play tests."""
+from pathlib import Path
+import re
+
+root = Path(__file__).resolve().parents[1]
+j = root / 'core/src/main/java/com/shatteredpixel/shatteredpixeldungeon'
+checks = 0
+def check(ok, message):
+    global checks
+    checks += 1
+    if not ok: raise AssertionError(message)
+def read(name): return (j / name).read_text()
+def method(source, signature):
+    start = source.index('{', source.index(signature))
+    depth = 1
+    for end in range(start + 1, len(source)):
+        if source[end] == '{': depth += 1
+        elif source[end] == '}': depth -= 1
+        if depth == 0: return source[start+1:end]
+    raise AssertionError('Unclosed method: ' + signature)
+
+hero_classes = re.findall(r'\b([A-Z_]+)\( HeroSubClass\.', read('actors/hero/HeroClass.java'))
+check(hero_classes == ['WARRIOR','MAGE','ROGUE','HUNTRESS','DUELIST','CLERIC','WEREWOLF'], 'old class order changed')
+subclasses = re.findall(r'\b([A-Z_]+)\(HeroIcon\.', read('actors/hero/HeroSubClass.java'))
+check(subclasses[:13] == ['NONE','BERSERKER','GLADIATOR','BATTLEMAGE','WARLOCK','ASSASSIN','FREERUNNER','SNIPER','WARDEN','CHAMPION','MONK','PRIEST','PALADIN'], 'old subclass order changed')
+check(subclasses[-2:] == ['BLOODFANG','MOONSHADOW'], 'new subclasses not appended')
+talent = read('actors/hero/Talent.java')
+blood = {'DEEP_WOUNDS','BLOOD_SCENT','THIRST','REOPEN_WOUNDS','BLOOD_FEAST'}
+moon = {'LONG_LEAP','HUNT_BEGINS','CONTINUOUS_HUNT','AFTERIMAGE','NECK_STRIKE'}
+for label, group in [('BLOODFANG',blood),('MOONSHADOW',moon)]:
+    block = re.search(r'case '+label+r':\s*Collections.addAll\(tierTalents, ([^)]+)\);',talent).group(1)
+    check(set(block.replace(' ','').split(',')) == group, label + ' talent isolation')
+    for name in group:
+        check(bool(re.search(r'\b'+name+r'\(\d+\)',talent)), name + ' must have the default two ranks')
+check(not blood & moon, 'subclass overlap')
+level=read('levels/Level.java')
+check('createWerewolfProvisions();' in method(level,'public void create()'), 'provisions missing from initial generation')
+check('createWerewolfProvisions' not in method(level,'public void restoreFromBundle'), 'provisions replayed on load')
+check('createWerewolfProvisions' not in read('Dungeon.java'), 'provisions triggered by a transition')
+check(level.count('createWerewolfProvisions();') == 1, 'multiple provision call sites')
+check('werewolfProvisionsPlaced' in method(level,'protected void createWerewolfProvisions()'), 'no per-floor guard')
+check('ww_provisions_placed' in method(level,'public void restoreFromBundle'), 'floor flag not loaded')
+check('ww_provisions_placed' in method(level,'public void storeInBundle'), 'floor flag not saved')
+hero=read('actors/hero/Hero.java')
+for key in ['ww_kills','ww_hunger_shield_used']:
+    check(key in method(hero,'public void storeInBundle'), key+' not saved')
+    check(key in method(hero,'public void restoreFromBundle'), key+' not loaded')
+claws=read('items/weapon/melee/Claws.java')
+for key in ['ww_heart_charge','ww_pounce_charge']:
+    check(key in method(claws,'public void storeInBundle'), key+' not saved')
+    check(key in method(claws,'public void restoreFromBundle'), key+' not loaded')
+check('super.storeInBundle(bundle)' in method(claws,'public void storeInBundle'), 'base weapon level/enchantment not saved')
+check('super.enchant(' in method(claws,'public void sharpen()') and 'level(' not in method(claws,'public void sharpen()'), 'whetstone changes growth')
+check('return false;' in method(claws,'public boolean isUpgradable()'), 'claws allow ordinary upgrades')
+check('return this;' in method(claws,'public Weapon enchant('), 'ordinary enchantments not blocked')
+check('instanceof Claws' in method(read('items/KindOfWeapon.java'),'public boolean doEquip'), 'main equipment restriction missing')
+check('instanceof Claws' in method(read('items/KindOfWeapon.java'),'public boolean equipSecondary'), 'secondary equipment restriction missing')
+check('instanceof Claws' in read('levels/traps/DisarmingTrap.java'), 'disarming removes body weapon')
+check('instanceof Claws' in method(read('items/scrolls/ScrollOfTransmutation.java'),'protected boolean usableOnItem'), 'transmutation removes body weapon')
+check('!WerewolfMechanics.isWerewolf(hero)' in method(read('items/food/MysteryMeat.java'),'protected void satisfy'), 'raw meat penalty not gated')
+check('MysteryMeat.effect(hero)' in method(read('items/food/Pasty.java'),'protected void satisfy'), 'pasty duplicates/omits raw meat roll')
+check('new ClawWhetstone.Recipe()' in read('items/Recipe.java'), 'recipe not registered')
+check('new ClawWhetstone.Recipe()' in read('ui/QuickRecipe.java'), 'recipe not visible')
+check('ScrollOfRage.enrage(hero)' in read('actors/hero/abilities/werewolf/BeastRampage.java'), 'rage logic not reused')
+check('Math.round' in read('actors/hero/WerewolfBalance.java'), 'armor rounding unspecified')
+check('WerewolfMechanics.isWerewolf(Dungeon.hero)' in method(level,'public float respawnCooldown()'), 'spawn increase is global')
+check('HeroClass.values().length - 1' in method(read('SPDSettings.java'),'public static int lastClass()'), 'new class selection is truncated')
+check('WerewolfMechanics.onFood(hero, foodSource)' in method(talent,'public static void onFoodEaten'), 'food hook does not cover horn meals')
+check('Buff.detach(mob, PreyMark.class)' in read('actors/hero/abilities/werewolf/BeastRampage.java'), 'rampage leaves attack marks behind')
+
+for section in ['actors','items']:
+    localized=[]
+    for suffix in ['', '_ko']:
+        p=root/'core/src/main/assets/messages'/section/(section+suffix+'.properties')
+        text=p.read_text();new=text.split('# Werewolf mod\n')[1];messages={}
+        for line in new.splitlines():
+            if not line or line.startswith('#'):continue
+            key,value=line.split('=',1)
+            check(key not in messages,'duplicate new localization: '+key)
+            messages[key]=value
+            check(value!='','empty localization: '+key)
+            if '%s' in value or '%d' in value:
+                check(not re.search(r'%(?![%sd])',value.replace('%%','')), 'bad formatting percent: '+key)
+        localized.append(messages)
+    check(localized[0].keys()==localized[1].keys(),section+' localization keys differ')
+    if section=='actors':
+        for messages in localized:
+            check(len(messages['actors.hero.heroclass.werewolf_desc'].split('\\n\\n')) == 3,'hero description/icon row mismatch')
+            for t in blood|moon:
+                check('actors.hero.talent.'+t.lower()+'.desc' in messages,'missing talent text '+t)
+
+print(f'PASS: {checks} source-contract/localization checks (not gameplay tests)')
